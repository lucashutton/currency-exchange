@baseUrl = http://localhost:5115

### list supported currencies (expect 200)
GET {{baseUrl}}/api/currencies
Accept: application/json

### normal currency exchange (expect 200)
GET {{baseUrl}}/api/convert?from=GBP&to=USD&amount=100
Accept: application/json

### lowercase codes also accepted (expect 200)
GET {{baseUrl}}/api/convert?from=gbp&to=usd&amount=100
Accept: application/json

### negative amounts rejected (expect 400)
GET {{baseUrl}}/api/convert?from=GBP&to=USD&amount=-100
Accept: application/json

### unknown codes rejected (expect 400)
GET {{baseUrl}}/api/convert?from=XYZ&to=USD&amount=100
Accept: application/json

### illegal amounts rejected (expect 400)
GET {{baseUrl}}/api/convert?from=GBP&to=USD&amount=abc
Accept: application/json