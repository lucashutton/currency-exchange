@page "/"

@* Api property filled with client registered in Program.cs *@
@inject CurrencyApiClient Api

<PageTitle>Currency Exchange</PageTitle>

<div class="converter card shadow-sm mx-auto mt-5">
    <div class="card-body p-4">
        <h1 class="h3 mb-4">Currency Exchange</h1>

        @* novalidate: turn off browser's built-in validation and use AmountError instead *@
        <form @onsubmit="ConvertAsync" novalidate>
            <div class="mb-3">
                <label for="amount" class="form-label">Amount</label>
                <input id="amount" type="number" step="any" class="form-control"
                       @bind="amount" @bind:after="ClearResult" />
                @if (AmountError is not null)
                {
                    <div class="text-danger small mt-1">@AmountError</div>
                }
            </div>

            <div class="d-flex align-items-end gap-2 mb-4">
                <div class="flex-fill">
                    <label for="from" class="form-label">From</label>
                    <select id="from" class="form-select" disabled="@(currencies.Count == 0)"
                            @bind="from" @bind:after="ClearResult">
                        @foreach (CurrencyDto currency in currencies)
                        {
                            <option value="@currency.Code">@currency.Code – @currency.Name</option>
                        }
                    </select>
                </div>

                @* type="button" so clicking it doesn't submit the form *@
                <button type="button" class="btn btn-outline-secondary" title="Swap currencies"
                        aria-label="Swap currencies" @onclick="Swap">⇄</button>

                <div class="flex-fill">
                    <label for="to" class="form-label">To</label>
                    <select id="to" class="form-select" disabled="@(currencies.Count == 0)"
                            @bind="to" @bind:after="ClearResult">
                        @foreach (CurrencyDto currency in currencies)
                        {
                            <option value="@currency.Code">@currency.Code – @currency.Name</option>
                        }
                    </select>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100"
                    disabled="@(AmountError is not null || isLoading || currencies.Count == 0)">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    <span>Converting…</span>
                }
                else
                {
                    <span>Convert</span>
                }
            </button>
        </form>

        @if (error is not null)
        {
            <div class="alert alert-danger mt-4 mb-0" role="alert">@error</div>
        }
        else if (result is not null)
        {
            <div class="bg-light rounded mt-4 p-3">
                <div class="text-muted">@result.Amount.ToString("N2") @result.From =</div>
                <div class="fs-2 fw-semibold">@result.ConvertedAmount.ToString("N2") @result.To</div>
                <div class="small text-muted mt-1">
                    1 @result.From = @result.Rate @result.To · ECB rates from @result.RateDate.ToString("d MMMM yyyy")
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<CurrencyDto> currencies = [];
    private string from = "GBP";
    private string to = "USD";
    private decimal? amount = 100;

    private bool isLoading;
    private string? error;
    private ConversionResponse? result;

    private string? AmountError => amount switch
    {
        null => "Enter an amount.",
        <= 0 => "Amount must be greater than 0.",
        _ => null
    };

    // on initialisation, get currency list
    protected override async Task OnInitializedAsync()
    {
        error = null;
        try
        {
            currencies = await Api.GetCurrenciesAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }

    }

    // swap two currencies being converted
    private void Swap()
    {
        (from, to) = (to, from);
    }

    private void ClearResult() 
    { 
        result = null; 
    }

    // call api to convert currencies
    private async Task ConvertAsync()
    {
        error = null;
        ClearResult();

        isLoading = true;
        try
        {
            if (amount is not decimal value)
            {
                return;
            }
            result = await Api.ConvertAsync(from, to, amount.Value);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
